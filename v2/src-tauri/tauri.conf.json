{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mini Video Tool",
  "version": "2.0.1",
  "identifier": "com.minivideotool.v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mini Video Tool",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-window"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/mini-video-tool-v2/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe", "binaries/yt-dlp"]
  }
}
